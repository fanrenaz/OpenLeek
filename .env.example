# Copy this file to .env for a Compose deployment. Because the Compose files
# live under infra/, invoke Compose with --env-file .env to load this root file.
# Values below are local-only defaults; use deployment-managed secrets in shared
# environments.

# The only host-published service is Console.
OPENLEEK_CONSOLE_PORT=13000
OPENLEEK_OBSERVABILITY_NETWORK=openleek-observability-ingest
# Required for the Console password gate. Use a long random session secret.
OPENLEEK_CONSOLE_ACCESS_PASSWORD=
OPENLEEK_CONSOLE_PUBLIC_ORIGIN=http://localhost:13000
OPENLEEK_CONSOLE_ACCESS_SESSION_SECRET=

# PostgreSQL administrator and owner-role passwords. The unified startup
# command creates one database and one least-privilege owner role per Context.
OPENLEEK_POSTGRES_ADMIN_PASSWORD=openleek-admin-password
OPENLEEK_EXPERIMENT_DB_PASSWORD=openleek-experiment-password
OPENLEEK_AGENT_EXECUTION_DB_PASSWORD=openleek-agent-execution-password
OPENLEEK_SOCIAL_ENVIRONMENT_DB_PASSWORD=openleek-social-environment-password
OPENLEEK_FINANCIAL_MARKET_DB_PASSWORD=openleek-financial-market-password

# Agent Codex sandboxes connect directly to the DeepSeek Responses API.
DEEPSEEK_API_KEY=

# LLM Configuration is retained only for Hindsight memory bootstrap.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENLEEK_LLM_ROUTER_DEFAULT_MODEL=

# Byte-bounded lazy caches for immutable Context history.
OPENLEEK_FINANCIAL_REVISION_CACHE_MAX_BYTES=536870912
OPENLEEK_FINANCIAL_SEAL_CACHE_MAX_BYTES=134217728
OPENLEEK_SOCIAL_REVISION_CACHE_MAX_BYTES=268435456

# Experiment owns run-scoped Agent identity credentials. Use an Ed25519
# PKCS#8 PEM for the private key and its matching public PEM for Context
# verification. Keep the private key only in Experiment deployment secrets.
OPENLEEK_EXPERIMENT_CREDENTIAL_KID=local-ed25519-v1
OPENLEEK_EXPERIMENT_CREDENTIAL_PRIVATE_KEY=
OPENLEEK_EXPERIMENT_CREDENTIAL_PUBLIC_KEY=

# Social Environment is the only service allowed to access Neo4j. Neo4j holds
# a rebuildable publish-only projection; PostgreSQL remains the source of truth.
OPENLEEK_SOCIAL_NEO4J_PASSWORD=openleek-social-neo4j-password

# This must be an absolute, Docker-writable host directory. Each run receives
# an opaque child directory which is deleted when that run becomes terminal.
OPENLEEK_SANDBOX_RUNS_HOST_PATH=
# Deployment secret shared only by Agent Execution and dynamic Sandbox
# app-servers. Never commit its value.
OPENLEEK_SANDBOX_APP_SERVER_TOKEN=
OPENLEEK_CHATGPT_AUTH_BROKER_TOKEN=
OPENLEEK_SANDBOX_HOOK_SECRET=replace-with-at-least-32-random-characters
